  <question type="multichoice">
    <name><text>What is the key difference between regression and classification?</text></name>
    <questiontext format="moodle_auto_format">
      <text>What is the key difference between regression and classification?</text>
    </questiontext>
    <generalfeedback format="moodle_auto_format"><text /></generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="moodle_auto_format">
      <text>Predicts continuous output vs discrete labels</text>
      <feedback format="moodle_auto_format"><text>Correct: Regression predicts continuous values, while classification predicts categories.</text></feedback>
    </answer>
    <answer fraction="0" format="moodle_auto_format">
      <text>Uses more features in classification</text>
      <feedback format="moodle_auto_format"><text>Try again.</text></feedback>
    </answer>
    <answer fraction="0" format="moodle_auto_format">
      <text>Logistic regression uses sigmoid, linear regression does not</text>
      <feedback format="moodle_auto_format"><text>Try again.</text></feedback>
    </answer>
    <answer fraction="0" format="moodle_auto_format">
      <text>Regression uses accuracy while classification does not</text>
      <feedback format="moodle_auto_format"><text>Try again.</text></feedback>
    </answer>
  </question>

